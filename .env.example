# Copie este arquivo para .env (ou defina as variáveis no sistema). NUNCA suba o .env para o Git.

# Obrigatória. Gere uma chave assim:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SISFISC_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Endereço e porta do servidor (padrão: somente a própria máquina)
SISFISC_HOST=127.0.0.1
SISFISC_PORT=8080

# Coloque 1 quando o sistema estiver atrás de HTTPS (cookie de sessão só trafega criptografado)
SISFISC_HTTPS=0

# Caminho do banco SQLite (padrão: instance/sisfisc.db)
# SISFISC_DB=C:\dados\sisfisc.db
